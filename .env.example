# Database (SQLite by default; set PostgreSQL URL to use Postgres)
DATABASE_URL=sqlite:///data/japan_cars.db

# Exchange rate: 1 USD = X KES (update regularly)
USD_TO_KES=130.0
JPY_TO_USD=0.0067

# Safer BE FORWARD settings
SCRAPER_DELAY_SECONDS=4
SCRAPER_MAX_PAGES=8
SCRAPER_MAX_PAGES_PER_MAKE=8
SCRAPER_USE_SAMPLE_DATA=false
SCRAPER_MAKE_PAUSE_SECONDS=10
SCRAPER_BLOCK_COOLDOWN_SECONDS=180
SCRAPER_PAGE_RETRIES=4
SCRAPER_CLEAR_DB=false
SCRAPER_CLEAR_LISTINGS=true
SCRAPER_CLEAR_LOCAL_PRICES=false
SCRAPER_REFRESH_LOCAL_PRICES=false
SCRAPER_USE_REAL_LOCAL_PRICES=true

# Kenya sources: cheki,jiji,autochek
LOCAL_SCRAPER_SOURCES=cheki,jiji,autochek
LOCAL_SCRAPER_MAX_PAGES_PER_MAKE=3
LOCAL_SCRAPER_MAKES=toyota,nissan,honda,mazda,mitsubishi,subaru,suzuki,bmw,mercedes,audi,volkswagen,ford,range-rover,jeep,lexus,hyundai,kia,isuzu,daihatsu,volvo,peugeot

# ML model path
MODEL_PATH=models/price_predictor.joblib
